#!/usr/bin/env python3
"""Derive the proposed v2 designated-aliases schema from the pinned v1 one, and print its SAID.

Decision 35yl884k: the v2 schema is the v1 schema (GLEIF's ``EN6Oh5…``) changed only where a v2
ACDC differs, so anyone can check the derivation instead of trusting the resource file:

* ``ri`` (v1 registry identifier) becomes ``rd`` (v2 registry SAID), in the same position;
* ``t`` (v2 message type) is added and required, fixed to ``acm``;
* ``u`` (v2 salty nonce) is added and optional, since public mode allows it empty;
* properties are ordered as a v2 ``acm`` serializes its fields: ``v t d u i rd s a r``;
* ``version`` becomes ``2.0.0``.

Everything else -- title, description, credentialType, the attribute and rules blocks,
``additionalProperties: false`` -- is byte-for-byte v1's. The SAID is computed by keripy's
``Schemer`` over that body with ``$id`` blank, exactly as v1's was.

Usage (from the repo root):  uv run tools/mint-v2-aliases-schema [--write]
"""

import json
import sys
from pathlib import Path

from keri.core import scheming

SCHEMAS = Path(__file__).resolve().parents[1] / "src" / "didwebs" / "schemas"
V1 = SCHEMAS / "designated-aliases-public-schema.json"
V2 = SCHEMAS / "designated-aliases-public-schema-v2.json"

ORDER = ("v", "t", "d", "u", "i", "rd", "s", "a", "r")


def derive() -> scheming.Schemer:
    v1 = json.loads(V1.read_text())
    props = dict(v1["properties"])
    props["rd"] = props.pop("ri")
    props["t"] = {"description": "Message type", "type": "string", "const": "acm"}
    props["u"] = {"description": "Salty nonce", "type": "string"}
    assert set(props) == set(ORDER), sorted(props)

    v2 = dict(v1)
    v2["$id"] = ""
    v2["version"] = "2.0.0"
    v2["properties"] = {name: props[name] for name in ORDER}
    v2["required"] = [name for name in ORDER if name != "u"]
    return scheming.Schemer(sed=v2, code="E")


def main(argv) -> int:
    schemer = derive()
    print(schemer.said)
    if "--write" in argv:
        V2.write_bytes(schemer.raw)
    elif V2.exists() and V2.read_bytes() != schemer.raw:
        print(f"{V2} differs from the derivation; re-run with --write", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
